# ---- required ----
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Generated with: npm run gen-seal-key   (secret stays on the worker only)
VAULT_SEAL_SECRET=
TELEGRAM_BOT_TOKEN=
# Your own chat id: receives system alerts and can use /stats
ADMIN_CHAT_ID=

# ---- live trading master switch ----
# false (default) = every user is forced to PAPER mode, whatever their settings say.
LIVE_TRADING_ENABLED=false

# ---- RPC: free public ones will not carry many users. Put paid endpoints first. ----
# RPC_URLS=https://mainnet.helius-rpc.com/?api-key=...,https://api.mainnet-beta.solana.com

# ---- platform hard caps (a user's own limits can never exceed these) ----
CAP_MAX_POSITION_SOL=0
# 0 = no platform cap on trade size (users set their own; their signed max-per-trade in SOL still applies)
CAP_MAX_SIZE_USD=0
CAP_MAX_DAILY_LOSS_PCT=50
CAP_MAX_CONCURRENT=3
MIN_VAULT_SOL=0.015
MIN_POSITION_SOL=0.01
SOL_FEE_RESERVE=0.006
MIN_LIQUIDITY_USD=3000
REQUIRE_NO_AUTHORITIES=true
PAPER_BALANCE_SOL=1
MAX_POOL_SHARE_PCT=5
STREAM_ENABLED=true
